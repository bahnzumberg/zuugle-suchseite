{
    "name": "zuugle-api (sandboxed)",
    "build": {
        "dockerfile": "Dockerfile"
    },
    // Required only so the in-container egress firewall can program iptables/ipset.
    "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
    "remoteUser": "node",
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/node/.claude",
        // Drop optional telemetry/error-reporting egress (Statsig/Sentry) so the
        // allowlist can stay tiny. Remove if you want usage metrics.
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
    },
    // Persist Claude Code auth + settings across rebuilds (per-project volume,
    // not shared with other repos). No host secrets are mounted in.
    "mounts": ["source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume"],
    // Apply the egress allowlist once the container network is up, then start the
    // in-container Postgres.
    "postStartCommand": "sudo /usr/local/bin/init-firewall.sh && sudo /usr/local/bin/start-postgres.sh",
    "waitFor": "postStartCommand",
    "customizations": {
        "settings": {
            "remote.containers.copyGitConfig": false
        },
        "vscode": {
            "extensions": ["anthropic.claude-code"]
        }
    }
}
