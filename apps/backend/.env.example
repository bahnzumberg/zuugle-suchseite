# Copy to .env and fill in your values. .env is gitignored — never commit real secrets.
# On servers these come from the process env (PM2 env block / systemd EnvironmentFile).
#
# NODE_ENV selects which config key is used (production|development); both keys read the
# same variables below, so a host's env alone determines which database it talks to.
NODE_ENV=development

# --- Docker compose stack (local, DEV, UAT) ---
# COMPOSE_PROJECT_NAME namespaces the containers and lets the same docker-compose.yaml
# run several isolated stacks on one host. Use `zuugle` locally; on the shared server
# use `zuugle-uat` / `zuugle-dev` in the respective app dirs. Leave UNSET on native
# (PROD) hosts — that is how the DB jobs know a host is not compose-managed.
COMPOSE_PROJECT_NAME=zuugle
# Image tags (override to pin/upgrade without editing docker-compose.yaml).
POSTGRES_IMAGE=pgvector/pgvector:pg18
VALKEY_IMAGE=valkey/valkey:8-alpine

# --- Main search database (PostgreSQL, knexfile.js) ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=docker
DB_NAME=zuugle_suchseite_dev
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Cache (Valkey/Redis, config.js) ---
CACHE_PORT=6379

# --- Tour source database (MySQL, knexfileTourenDb.js, read-only) ---
# Only needed on PROD to run `npm run import-data-prod` (syncDataProd.js).
# Local / DEV / UAT use `npm run import-data` (a PostgreSQL dump) and leave these blank.
TOUREN_DB_HOST=
TOUREN_DB_USER=
TOUREN_DB_PASSWORD=
TOUREN_DB_NAME=tourendatenbank
