{
    "name": "zuugle-api",
    "version": "3.0.0",
    "description": "",
    "main": "index.js",
    "engines": {
        "node": "^24.18.0",
        "npm": ">=11"
    },
    "bugs": {
        "url": "https://github.com/bahnzumberg/zuugle-api/issues/",
        "email": "test@zuugle.at"
    },
    "scripts": {
        "start": "tsx watch src/index.js",
        "build": "npm run build:compile && npm run build:copy && npm run build:patch",
        "build:compile": "tsc -p tsconfig.build.json",
        "build:copy": "cp docker-compose.yaml restore_databases.sh package.json package-lock.json ./build/ && (test -f .env && cp .env ./build/ || true) && cp -r scripts build/ && cp -r src/migrations build/ && cp -r src/utils/gpx/error-images build/utils/gpx/ && cp -r src/utils/country-geojson build/utils/ && mkdir -p public && cp -r public build/ && cp -r ../../assets/public/. build/public/",
        "build:patch": "sed -i -e 's|node build/|node |g' -e 's|--knexfile build/|--knexfile |g' ./build/package.json",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "reset-database": "node build/jobs/resetDatabase.js",
        "rebuild-docker": "node build/jobs/rebuildDocker.js",
        "migrate": "knex --knexfile build/knexfile.js migrate:latest",
        "migrate:make": "knex --knexfile src/knexfile.js migrate:make",
        "migrate:rollback": "knex --knexfile build/knexfile.js migrate:rollback",
        "migrate:status": "knex --knexfile build/knexfile.js migrate:status",
        "import-data": "node build/jobs/syncDataImport.js",
        "import-data-prod": "node build/jobs/syncDataProd.js",
        "import-files": "node build/jobs/syncFiles.js",
        "import-weather": "node build/jobs/syncWeather.js",
        "refresh-search-suggestions": "node build/jobs/refreshSearchSuggestions.js",
        "generate-weather-overlay": "node build/jobs/generateWeatherOverlay.js",
        "prune-user-lists": "node build/jobs/pruneUserLists.js",
        "cleanup-orphaned-files": "node build/jobs/cleanupOrphanedFiles.js",
        "create-backup": "node build/jobs/createBackup.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint --cache",
        "lint:fix": "eslint --cache --fix",
        "tsc": "tsc --noEmit"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "prettier": "^3.9.10",
        "ts-jest": "^29.4.15",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "cross-spawn": "^7.0.6",
        "dotenv": "^18.0.9",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.2",
        "fs-extra": "^11.4.1",
        "ioredis": "^5.11.1",
        "knex": "^3.3.0",
        "moment": "^2.31.0",
        "pg": "^8.23.1",
        "puppeteer": "^25.16.0",
        "rate-limit-redis": "^6.0.2",
        "sharp": "^0.35.5",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "xml-js": "^1.6.11",
        "xmlbuilder2": "^4.0.3"
    },
    "volta": {
        "node": "24.18.0"
    }
}
