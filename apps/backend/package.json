{
    "name": "zuugle-api",
    "version": "3.0.0",
    "description": "",
    "main": "index.js",
    "engines": {
        "node": "^24.18.0",
        "npm": ">=11"
    },
    "bugs": {
        "url": "https://github.com/bahnzumberg/zuugle-api/issues/",
        "email": "test@zuugle.at"
    },
    "scripts": {
        "start": "tsx watch src/index.js",
        "build": "npm run build:compile && npm run build:copy && npm run build:patch",
        "build:compile": "tsc -p tsconfig.build.json",
        "build:copy": "cp docker-compose.yaml restore_databases.sh package.json package-lock.json ./build/ && cp -r src/migrations build/ && cp -r src/utils/gpx/error-images build/utils/gpx/ && cp -r src/utils/country-geojson build/utils/ && cp -r public build/",
        "build:patch": "sed -i -e 's|node build/|node |g' -e 's|--knexfile build/|--knexfile |g' ./build/package.json",
        "test": "jest",
        "reset-database": "node build/jobs/resetDatabase.js",
        "rebuild-docker": "node build/jobs/rebuildDocker.js",
        "migrate": "knex --knexfile build/knexfile.js migrate:latest",
        "migrate:make": "knex --knexfile src/knexfile.js migrate:make",
        "migrate:rollback": "knex --knexfile build/knexfile.js migrate:rollback",
        "migrate:status": "knex --knexfile build/knexfile.js migrate:status",
        "import-data": "node build/jobs/syncDataImport.js",
        "import-data-prod": "node build/jobs/syncDataProd.js",
        "import-files": "node build/jobs/syncFiles.js",
        "refresh-search-suggestions": "node build/jobs/refreshSearchSuggestions.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint --cache",
        "lint:fix": "eslint --cache --fix",
        "tsc": "tsc --noEmit"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.0",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "jest": "^30.4.2",
        "pixelmatch": "^7.2.0",
        "prettier": "^3.8.4",
        "ts-jest": "^29.4.0",
        "tsx": "^4.20.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "cross-spawn": "^7.0.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "fs-extra": "^11.3.5",
        "ioredis": "^5.11.1",
        "knex": "^3.2.10",
        "moment": "^2.30.1",
        "moment-timezone": "^0.6.2",
        "mysql2": "^3.22.5",
        "pg": "^8.21.0",
        "puppeteer": "^24.43.1",
        "sharp": "^0.35.3",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "xml-js": "^1.6.11",
        "xmlbuilder2": "^4.0.3"
    },
    "volta": {
        "node": "24.18.0"
    }
}
