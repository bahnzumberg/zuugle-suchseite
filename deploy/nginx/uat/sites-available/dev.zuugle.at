# Only social-preview bots may skip auth (search engines / AI bots stay behind it).
map $http_user_agent $dev_social_bot {
    default 0;
    ~*facebookexternalhit 1;
    ~*Facebot             1;
    ~*Twitterbot          1;
    ~*LinkedInBot         1;
    ~*WhatsApp            1;
    ~*TelegramBot         1;
    ~*Discordbot          1;
    ~*Slackbot            1;
    ~*SkypeUriPreview     1;
}

# auth_basic is not allowed inside `if`, so the exemption is a map:
# social bots may fetch the tour preview page and the images it references,
# everything else gets the login prompt. Uses $request_uri because $uri is
# rewritten to /api/seo/... by the crawler location before auth runs.
map "$dev_social_bot$request_uri" $dev_auth_realm {
    default "Geschützter Bereich";
    "~^1/(tour/[0-9]+|opengraph\.jpg|range-image/)" off;
}

server {
    server_name dev.zuugle.at;

    root /root/suchseite/dev-app;
    index index.html;

    auth_basic $dev_auth_realm;
    auth_basic_user_file /etc/nginx/.htpasswd;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript;

    location /app_static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /i18n/ {
        expires 1h;
    }

    # ── Embed widget assets (no auth, permissive CORS) ──────────
    location /embed/ {
        auth_basic off;
        alias /root/suchseite/dev-embed/;
        expires 1h;
        add_header Cache-Control "public";
        add_header Access-Control-Allow-Origin "https://www.bahn-zum-berg.at" always;
    }

    # ── API proxy (no auth — required for cross-origin embed) ───
    location /api/ {
        auth_basic off;
        proxy_pass http://localhost:7070;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /public/ {
        auth_basic off;
        alias /root/suchseite/dev-api/public/;
        add_header Access-Control-Allow-Origin "https://www.bahn-zum-berg.at" always;
    }

    # ── Generated per-country sitemaps (backend public/) ───────
    location ~ ^/(sitemap_[a-z][a-z]\.xml)$ {
        alias /root/suchseite/dev-api/public/$1;
        default_type application/xml;
    }

    # ── Crawler / OpenGraph preview for tours ──────────────────
    # Social bots bypass auth (see $dev_auth_realm); other crawlers get 401.
    location ~ ^/tour/([0-9]+) {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        if ($is_crawler = 1) {
            rewrite ^(.*)$ /api/seo$1 break;
            proxy_pass http://localhost:7070;
        }
        rewrite ^/(.+)/$ /$1 permanent;
        try_files $uri $uri/ /index.html;
    }

    location / {
        rewrite ^/(.+)/$ /$1 permanent;
        try_files $uri $uri/ /index.html;
    }

    listen 443 ssl http2; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/dev.zuugle.at/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/dev.zuugle.at/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = dev.zuugle.at) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    server_name dev.zuugle.at;
    listen 80;
    return 404; # managed by Certbot
}
