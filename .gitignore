# Root monorepo ignores — app-specific ignores live in apps/{frontend,backend}/.gitignore
.DS_Store
*:Zone.Identifier
.idea
*.iml
node_modules/
.eslintcache
build/
playwright-report/
test-results/

# Local-only dev container — kept on disk, not tracked in the repo
.devcontainer/

# range-image/ is otherwise tracked (hand-curated); these are copyRangeImage()'s
# generated fallback and a stray Windows artifact, not source assets
assets/public/range-image/*.jpg
assets/public/range-image/desktop.ini
